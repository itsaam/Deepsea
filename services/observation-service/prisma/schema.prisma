generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Species {
  id            Int           @id @default(autoincrement())
  authorId      Int
  name          String        @unique
  rarityScore   Float         @default(1.0) 
  deleted       Boolean       @default(false)
  deletedBy     Int?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  observations  Observation[]
}

model Observation {
  id            Int       @id @default(autoincrement())
  speciesId     Int
  authorId      Int
  description   String
  status        Status    @default(PENDING)
  validatedBy   Int?
  validatedAt   DateTime?
  aiAnalysis    Json?
  deleted       Boolean   @default(false)
  deletedBy     Int?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  
  species       Species   @relation(fields: [speciesId], references: [id])
}

model UserReputation { 
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  score      Int      @default(0)
  isExpert   Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model Notification {
  id             Int      @id @default(autoincrement())
  userId         Int      // Destinataire
  type           NotificationType
  title          String
  message        String
  relatedId      Int?     // ID de l'observation/espèce concernée
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model ForceReviewUsage {
  id             Int      @id @default(autoincrement())
  userId         Int
  usedAt         DateTime @default(now())
  
  @@index([userId, usedAt])
}

enum Status {
  PENDING
  VALIDATED
  REJECTED
}

enum NotificationType {
  OBSERVATION_VALIDATED
  OBSERVATION_REJECTED
  REPUTATION_UPDATE
  PROMOTION_EXPERT
}